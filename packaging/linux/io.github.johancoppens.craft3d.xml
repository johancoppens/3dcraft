<?xml version="1.0" encoding="UTF-8"?>
<!-- The .3dcraft document type, the .3dcraftjig published Jig and the
     .3dcraftasm assembly for
     shared-mime-info (freedesktop.org Shared MIME-info Database
     specification). Both are a ZIP of stored entries (docs/file-formats.md),
     so the types are subclasses of application/zip and are recognised by
     their names, not their contents. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-craft3d">
    <comment>3DCraft document</comment>
    <sub-class-of type="application/zip"/>
    <generic-icon name="io.github.johancoppens.craft3d"/>
    <glob pattern="*.3dcraft" weight="80"/>
  </mime-type>
  <mime-type type="application/x-craft3d-jig">
    <comment>3DCraft Jig</comment>
    <sub-class-of type="application/zip"/>
    <icon name="io.github.johancoppens.craft3d-jig"/>
    <glob pattern="*.3dcraftjig" weight="80"/>
  </mime-type>
  <mime-type type="application/x-craft3d-assembly">
    <comment>3DCraft assembly</comment>
    <sub-class-of type="application/zip"/>
    <icon name="io.github.johancoppens.craft3d-asm"/>
    <glob pattern="*.3dcraftasm" weight="80"/>
  </mime-type>
</mime-info>
