  "variable.set",
  {
   "name": "ba90",
   "expr": "pi / 2 * (r + k * t)"
  }
 ],
 [
  "variable.set",
  {
   "name": "baj",
   "expr": "ja / 1 rad * (r + k * t)"
  }
 ],
 [
  "variable.set",
  {
   "name": "bah",
   "expr": "pi * (hem_r + k * t)"
  }
 ],
 [
  "variable.set",
  {
   "name": "off",
   "expr": "t + clr"
  }
 ],
 [
  "variable.set",
  {
   "name": "jm",
   "expr": "(off - 2 * (r + t / 2) * (1 - cos(ja))) / sin(ja)"
  }
 ],
 [
  "variable.set",
  {
   "name": "rise",
   "expr": "2 * (r + t / 2) * sin(ja) + jm * cos(ja)"
  }
 ],
 [
  "variable.set",
  {
   "name": "ztop",
   "expr": "t + r + h1 + rise + h2 + r + t"
  }
 ],
 [
  "variable.set",
  {
   "name": "hb",
   "expr": "ztop - t - r - 0.2 mm"
  }
 ],
 [
  "variable.set",
  {
   "name": "wall",
   "expr": "ba90 + h1 + 2 * baj + jm + h2 + ba90"
  }
 ],
 [
  "variable.set",
  {
   "name": "ld",
   "expr": "d + r + t"
  }
 ],
 [
  "variable.set",
  {
   "name": "lidh",
   "expr": "ztop - r - (t + r + h1 + rise) - 0.5 mm"
  }
