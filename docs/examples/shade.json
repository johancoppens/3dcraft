[
 ["variable.set", {"name": "big", "expr": "70 mm"}],
 ["variable.set", {"name": "small", "expr": "35 mm"}],
 ["variable.set", {"name": "height", "expr": "80 mm"}],
 ["variable.set", {"name": "t", "expr": "1.5 mm"}],
 ["sketch.create", {"name": "Low", "plane": "xy"}],
 ["sketch.arc", {"sketch": "Low", "center": [0, 0], "start": ["-big", 0], "end": ["big", 0]}],
 ["sketch.create", {"name": "High", "plane": "xy", "offset": "height"}],
 ["sketch.arc", {"sketch": "High", "center": [0, 0], "start": ["-small", 0], "end": ["small", 0]}],
 ["feature.developable", {"a": "Low", "b": "High", "name": "Panel"}],
 ["feature.plate", {"faces": ["F3:face(0)"], "thickness": "t", "side": "mid", "name": "Shade"}],
 ["feature.block", {"size": ["2 * big + 30 mm", "8 mm", "height + 50 mm"], "position": ["-big - 15 mm", "t / 2", "-25 mm"], "name": "Wall plate"}],
 ["feature.cylinder", {"radius": "5 mm", "height": "16 mm", "position": [0, "t / 2", "height / 2"], "axis": [0, -1, 0], "name": "Arm"}],
 ["feature.sphere", {"radius": "12 mm", "position": [0, "-26 mm", "height / 2"], "name": "Bulb"}],
 ["assert.add", {"name": "volume", "measure": "volume", "of": "Shade", "min": "0.999 * pi / 2 * (big + small) * sqrt((big - small)^2 + height^2) * t", "max": "1.001 * pi / 2 * (big + small) * sqrt((big - small)^2 + height^2) * t"}],
 ["assert.add", {"name": "the bulb clears the shade", "measure": "clearance", "from": "Bulb", "to": "Shade", "min": "5 mm"}],
 ["body.appearance", {"body": "Shade", "color": "#d99a4e", "metallic": 0, "roughness": 0.7, "subsurface": 0.5, "subsurfaceColor": "#ffcf8a"}],
 ["material.preset", {"body": "Wall plate", "preset": "wood", "color": "#6b4a2f"}],
 ["material.preset", {"body": "Arm", "preset": "aluminium-brushed", "color": "#b08d57"}],
 ["body.appearance", {"body": "Bulb", "color": "#fff4dc", "metallic": 0, "roughness": 0.2, "subsurface": 0.8, "subsurfaceColor": "#ffd27a"}],
 ["document.check", {}]
]
