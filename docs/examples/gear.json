[
 ["variable.set", {"name": "module", "expr": "2 mm"}],
 ["variable.set", {"name": "z", "expr": "12"}],
 ["variable.set", {"name": "alpha", "expr": "20 deg"}],
 ["variable.set", {"name": "width", "expr": "8 mm"}],
 ["variable.set", {"name": "rp", "expr": "module * z / 2"}],
 ["variable.set", {"name": "rb", "expr": "rp * cos(alpha)"}],
 ["variable.set", {"name": "ra", "expr": "rp + module"}],
 ["variable.set", {"name": "rf", "expr": "rp - 1.25 * module"}],
 ["variable.set", {"name": "rc", "expr": "rf - module / 2"}],
 ["variable.set", {"name": "g", "expr": "-pi / (2 * z) - (tan(alpha) - alpha / 1 rad)"}],
 ["variable.set", {"name": "ta", "expr": "sqrt((ra / rb)^2 - 1)"}],
 ["sketch.create", {"name": "Tooth"}],
 ["sketch.curve", {"sketch": "Tooth", "x": "rb * (cos(g + t) + t * sin(g + t))", "y": "rb * (sin(g + t) - t * cos(g + t))", "t": [0, "ta"]}],
 ["sketch.curve", {"sketch": "Tooth", "x": "rb * (cos(g + t) + t * sin(g + t))", "y": "-rb * (sin(g + t) - t * cos(g + t))", "t": [0, "ta"]}],
 ["sketch.point", {"sketch": "Tooth", "at": ["0 mm", "0 mm"]}],
 ["sketch.arc", {"sketch": "Tooth", "center": "e7", "start": "e2", "end": "e5"}],
 ["sketch.point", {"sketch": "Tooth", "at": ["rc * cos(g * 1 rad)", "rc * sin(g * 1 rad)"]}],
 ["sketch.point", {"sketch": "Tooth", "at": ["rc * cos(g * 1 rad)", "-rc * sin(g * 1 rad)"]}],
 ["sketch.line", {"sketch": "Tooth", "from": "e9", "to": "e1"}],
 ["sketch.line", {"sketch": "Tooth", "from": "e10", "to": "e4"}],
 ["sketch.arc", {"sketch": "Tooth", "center": "e7", "start": "e9", "end": "e10"}],
 ["feature.extrude", {"sketch": "Tooth", "distance": "width", "name": "T"}],
 ["feature.pattern", {"source": "T", "count": "z", "angle": "360 deg / z", "axis": [0, 0, 1], "name": "Teeth"}],
 ["feature.cylinder", {"radius": "rf", "height": "width", "name": "Root"}],
 ["feature.boolean", {"op": "union", "target": "Root", "tool": "Teeth", "name": "Gear"}],
 ["assert.add", {"name": "volume", "measure": "volume", "of": "Gear", "eq": "(pi * rf^2 + z * (rb^2 * ta^3 / 3 - ra^2 * (g + ta - atan(ta) / 1 rad) + rf^2 * g)) * width"}],
 ["assert.add", {"name": "one body", "measure": "count", "of": {"kind": "body"}, "eq": "1"}],
 ["body.appearance", {"body": "Gear", "color": "#7d858c", "metallic": 0.9, "roughness": 0.35}],
 ["document.check", {}]
]
