[
 ["variable.set", {"name": "flange_a", "expr": "30 mm"}],
 ["variable.set", {"name": "web", "expr": "36 mm"}],
 ["variable.set", {"name": "flange_c", "expr": "20 mm"}],
 ["variable.set", {"name": "bend_r", "expr": "2 mm"}],
 ["variable.set", {"name": "thickness", "expr": "2 mm"}],
 ["variable.set", {"name": "width", "expr": "25 mm"}],
 ["variable.set", {"name": "hole_d", "expr": "5 mm"}],
 ["sketch.create", {"name": "Profile", "plane": "xy"}],
 ["sketch.path", {"sketch": "Profile", "start": ["0 mm", "0 mm"], "segments": [
   {"line": ["flange_a", 0]},
   {"arc": ["flange_a + bend_r + thickness", "thickness + bend_r"], "center": ["flange_a", "thickness + bend_r"]},
   {"line": ["flange_a + bend_r + thickness", "thickness + bend_r + web"]},
   {"arc": ["flange_a + 2 * bend_r + thickness", "thickness + 2 * bend_r + web"], "center": ["flange_a + 2 * bend_r + thickness", "thickness + bend_r + web"], "clockwise": true},
   {"line": ["flange_a + 2 * bend_r + thickness + flange_c", "thickness + 2 * bend_r + web"]},
   {"line": ["flange_a + 2 * bend_r + thickness + flange_c", "2 * thickness + 2 * bend_r + web"]},
   {"line": ["flange_a + 2 * bend_r + thickness", "2 * thickness + 2 * bend_r + web"]},
   {"arc": ["flange_a + bend_r", "thickness + bend_r + web"], "center": ["flange_a + 2 * bend_r + thickness", "thickness + bend_r + web"]},
   {"line": ["flange_a + bend_r", "thickness + bend_r"]},
   {"arc": ["flange_a", "thickness"], "center": ["flange_a", "thickness + bend_r"], "clockwise": true},
   {"line": [0, "thickness"]}
 ], "closed": true}],
 ["feature.extrude", {"sketch": "Profile", "distance": "width", "name": "Sheet"}],
 ["feature.cylinder", {"radius": "hole_d / 2", "height": "thickness + 2 mm", "axis": [0, 1, 0], "position": ["flange_a / 2", "-1 mm", "width / 2"], "name": "HoleA"}],
 ["feature.boolean", {"op": "subtract", "target": "Sheet", "tool": "HoleA", "name": "Drilled"}],
 ["feature.cylinder", {"radius": "hole_d / 2", "height": "thickness + 2 mm", "axis": [0, 1, 0], "position": ["flange_a + 2 * bend_r + thickness + flange_c / 2", "thickness + 2 * bend_r + web - 1 mm", "width / 2"], "name": "HoleC"}],
 ["feature.boolean", {"op": "subtract", "target": "Drilled", "tool": "HoleC", "name": "ZBracket"}]
]
