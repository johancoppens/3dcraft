[
 ["variable.set", {"name": "knob_d", "expr": "30 mm"}],
 ["variable.set", {"name": "height", "expr": "16 mm"}],
 ["variable.set", {"name": "n", "expr": "18"}],
 ["variable.set", {"name": "groove_d", "expr": "3 mm"}],
 ["variable.set", {"name": "bore_d", "expr": "6 mm"}],
 ["variable.set", {"name": "flat", "expr": "4.5 mm"}],
 ["variable.set", {"name": "bore_depth", "expr": "12 mm"}],
 ["feature.cylinder", {"radius": "knob_d / 2", "height": "height", "name": "Knob"}],
 ["feature.cylinder", {"radius": "groove_d / 2", "height": "height + 2 mm", "position": ["knob_d / 2", 0, "-1 mm"], "name": "Flute"}],
 ["feature.pattern", {"source": "Flute", "count": "n", "angle": "360 deg / n", "axis": [0, 0, 1], "name": "Flutes"}],
 ["feature.boolean", {"op": "subtract", "target": "Knob", "tool": "Flutes", "name": "Fluted"}],
 ["feature.cylinder", {"radius": "bore_d / 2", "height": "bore_depth + 1 mm", "position": [0, 0, "-1 mm"], "name": "BoreRound"}],
 ["feature.block", {"size": ["flat + 1 mm", "bore_d + 2 mm", "bore_depth + 3 mm"], "position": ["-bore_d / 2 - 1 mm", "-bore_d / 2 - 1 mm", "-2 mm"], "name": "BoreKeep"}],
 ["feature.boolean", {"op": "intersect", "target": "BoreRound", "tool": "BoreKeep", "name": "DBore"}],
 ["feature.boolean", {"op": "subtract", "target": "Fluted", "tool": "DBore", "name": "KnurledKnob"}]
]
