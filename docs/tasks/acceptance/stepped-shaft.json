[
 ["variable.set", {"name": "d1", "expr": "20 mm"}],
 ["variable.set", {"name": "l1", "expr": "30 mm"}],
 ["variable.set", {"name": "d2", "expr": "25 mm"}],
 ["variable.set", {"name": "l2", "expr": "40 mm"}],
 ["variable.set", {"name": "d3", "expr": "16 mm"}],
 ["variable.set", {"name": "l3", "expr": "25 mm"}],
 ["variable.set", {"name": "chamfer", "expr": "1 mm"}],
 ["variable.set", {"name": "key_w", "expr": "6 mm"}],
 ["variable.set", {"name": "key_depth", "expr": "3.5 mm"}],
 ["variable.set", {"name": "key_len", "expr": "25 mm"}],
 ["feature.cylinder", {"radius": "d1 / 2", "height": "l1", "axis": [1, 0, 0], "name": "Step1"}],
 ["feature.cylinder", {"radius": "d2 / 2", "height": "l2", "axis": [1, 0, 0], "position": ["l1", 0, 0], "name": "Step2"}],
 ["feature.cylinder", {"radius": "d3 / 2", "height": "l3", "axis": [1, 0, 0], "position": ["l1 + l2", 0, 0], "name": "Step3"}],
 ["feature.boolean", {"op": "union", "target": "Step1", "tool": "Step2", "name": "Steps12"}],
 ["feature.boolean", {"op": "union", "target": "Steps12", "tool": "Step3", "name": "Shaft"}],
 ["feature.chamfer", {"edges": [["F1:face(1)", "F1:face(0)"], ["F3:face(2)", "F3:face(0)"]], "distance": "chamfer", "name": "EndChamfers"}],
 ["feature.block", {"size": ["key_len", "key_w", "key_depth + 1 mm"], "position": ["l1 + (l2 - key_len) / 2", "-key_w / 2", "d2 / 2 - key_depth"], "name": "KeySlot"}],
 ["feature.boolean", {"op": "subtract", "target": "EndChamfers", "tool": "KeySlot", "name": "SteppedShaft"}]
]
