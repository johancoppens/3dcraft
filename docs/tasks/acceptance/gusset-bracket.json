[
 ["variable.set", {"name": "leg_x", "expr": "50 mm"}],
 ["variable.set", {"name": "leg_z", "expr": "40 mm"}],
 ["variable.set", {"name": "thickness", "expr": "5 mm"}],
 ["variable.set", {"name": "width", "expr": "30 mm"}],
 ["variable.set", {"name": "gusset_leg", "expr": "25 mm"}],
 ["variable.set", {"name": "gusset_t", "expr": "4 mm"}],
 ["variable.set", {"name": "hole_d", "expr": "6.6 mm"}],
 ["variable.set", {"name": "hole_in", "expr": "8 mm"}],
 ["variable.set", {"name": "hole_from_end", "expr": "12 mm"}],
 ["feature.block", {"size": ["leg_x", "width", "thickness"], "name": "Flat"}],
 ["feature.block", {"size": ["thickness", "width", "leg_z"], "name": "Upright"}],
 ["feature.boolean", {"op": "union", "target": "Flat", "tool": "Upright", "name": "Angle"}],
 ["sketch.create", {"name": "Gusset", "plane": "zx", "offset": "width / 2 - gusset_t / 2"}],
 ["sketch.point", {"sketch": "Gusset", "at": [0, 0]}],
 ["sketch.constrain", {"sketch": "Gusset", "type": "fixed", "entities": ["e1"]}],
 ["sketch.polyline", {"sketch": "Gusset", "points": [[5, 5], [5, 30], [30, 5]], "closed": true}],
 ["sketch.constrain", {"sketch": "Gusset", "type": "distance", "entities": ["e1", "e2"], "value": "thickness", "direction": "horizontal"}],
 ["sketch.constrain", {"sketch": "Gusset", "type": "distance", "entities": ["e1", "e2"], "value": "thickness", "direction": "vertical"}],
 ["sketch.constrain", {"sketch": "Gusset", "type": "distance", "entities": ["e1", "e3"], "value": "thickness", "direction": "horizontal"}],
 ["sketch.constrain", {"sketch": "Gusset", "type": "distance", "entities": ["e1", "e3"], "value": "thickness + gusset_leg", "direction": "vertical"}],
 ["sketch.constrain", {"sketch": "Gusset", "type": "distance", "entities": ["e1", "e4"], "value": "thickness + gusset_leg", "direction": "horizontal"}],
 ["sketch.constrain", {"sketch": "Gusset", "type": "distance", "entities": ["e1", "e4"], "value": "thickness", "direction": "vertical"}],
 ["feature.extrude", {"sketch": "Gusset", "distance": "gusset_t", "join": "Angle", "name": "Braced"}],
 ["feature.cylinder", {"radius": "hole_d / 2", "height": "thickness + 2 mm", "position": ["leg_x - hole_from_end", "hole_in", "-1 mm"], "name": "FlatHole"}],
 ["feature.pattern", {"source": "FlatHole", "count": 2, "step": [0, "width - 2 * hole_in", 0], "name": "FlatHoles"}],
 ["feature.boolean", {"op": "subtract", "target": "Braced", "tool": "FlatHoles", "name": "Drilled1"}],
 ["feature.cylinder", {"radius": "hole_d / 2", "height": "thickness + 2 mm", "axis": [1, 0, 0], "position": ["-1 mm", "hole_in", "leg_z - hole_from_end"], "name": "UpHole"}],
 ["feature.pattern", {"source": "UpHole", "count": 2, "step": [0, "width - 2 * hole_in", 0], "name": "UpHoles"}],
 ["feature.boolean", {"op": "subtract", "target": "Drilled1", "tool": "UpHoles", "name": "Bracket"}]
]
