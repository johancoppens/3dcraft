[
 ["variable.set", {"name": "across_flats", "expr": "8 mm"}],
 ["variable.set", {"name": "length", "expr": "20 mm"}],
 ["variable.set", {"name": "stud_len", "expr": "8 mm"}],
 ["variable.set", {"name": "tap_depth", "expr": "10 mm"}],
 ["sketch.create", {"name": "Hex", "plane": "xy"}],
 ["sketch.polyline", {"sketch": "Hex", "points": [["across_flats / sqrt(3)", 0], ["across_flats / (2 * sqrt(3))", "across_flats / 2"], ["-across_flats / (2 * sqrt(3))", "across_flats / 2"], ["-across_flats / sqrt(3)", 0], ["-across_flats / (2 * sqrt(3))", "-across_flats / 2"], ["across_flats / (2 * sqrt(3))", "-across_flats / 2"]], "closed": true}],
 ["feature.extrude", {"sketch": "Hex", "distance": "length", "name": "HexBar"}],
 ["feature.cylinder", {"radius": "2 mm", "height": "stud_len + 1 mm", "position": [0, 0, "length - 1 mm"], "name": "Stud"}],
 ["feature.boolean", {"op": "union", "target": "HexBar", "tool": "Stud", "name": "WithStud"}],
 ["feature.cylinder", {"radius": "3.3 mm / 2", "height": "tap_depth + 1 mm", "position": [0, 0, "-1 mm"], "name": "TapDrill"}],
 ["feature.boolean", {"op": "subtract", "target": "WithStud", "tool": "TapDrill", "name": "Standoff"}],
 ["feature.thread", {"face": "F3:face(0)", "start": "F3:face(2)", "size": "M4", "length": "6.5 mm", "name": "StudThread"}],
 ["feature.thread", {"face": "F5:face(0)", "start": "F2:startCap()", "size": "M4", "length": "8 mm", "name": "TapThread"}]
]
