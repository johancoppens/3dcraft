     ]
    },
    {
     "arc": [
      "rf_T16q * cos((2 * half_T16q + phis_T16q) * 1 rad)",
      "rf_T16q * sin((2 * half_T16q + phis_T16q) * 1 rad)"
     ],
     "center": [
      "0 mm",
      "0 mm"
     ]
    }
   ]
  }
 ],
