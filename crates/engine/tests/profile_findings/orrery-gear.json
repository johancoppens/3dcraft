      "ra_T16q * sin((thetaA_T16q) * 1 rad)"
     ],
     "through": [
      "rm_T16q * cos((phim_T16q) * 1 rad)",
      "rm_T16q * sin((phim_T16q) * 1 rad)"
     ]
    },
    {
     "arc": [
      "ra_T16q * cos((-thetaA_T16q) * 1 rad)",
      "ra_T16q * sin((-thetaA_T16q) * 1 rad)"
     ],
     "center": [
      "0 mm",
      "0 mm"
     ]
    },
    {
