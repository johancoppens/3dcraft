     ],
     "through": [
      "rm_T16q * cos((-phim_T16q) * 1 rad)",
      "rm_T16q * sin((-phim_T16q) * 1 rad)"
     ]
    },
    {
     "line": [
      "rf_T16q * cos((-phis_T16q) * 1 rad)",
